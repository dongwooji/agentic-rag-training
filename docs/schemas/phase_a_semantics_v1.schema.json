{
  "$defs": {
    "ArgumentResolution": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "not_started",
          "enum": [
            "ready",
            "clarification_required",
            "not_applicable",
            "not_started",
            "failure"
          ],
          "title": "Status",
          "type": "string"
        },
        "unresolved_fields": {
          "items": {
            "enum": [
              "canonical_exercise_name",
              "candidate_exercises",
              "exercise_resolution_status",
              "time_condition",
              "start_date",
              "end_date",
              "n_sessions",
              "requested_analyses",
              "comparison",
              "record_operation",
              "session_id",
              "literature_subquestion",
              "user_assumptions"
            ],
            "type": "string"
          },
          "title": "Unresolved Fields",
          "type": "array"
        }
      },
      "title": "ArgumentResolution",
      "type": "object"
    },
    "DefaultTimeWindow": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "default": false,
          "title": "Applied",
          "type": "boolean"
        },
        "policy": {
          "anyOf": [
            {
              "const": "recent_record_anchored",
              "enum": [
                "recent_record_anchored"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        },
        "trigger": {
          "anyOf": [
            {
              "enum": [
                "relative_recent",
                "operation_default"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        },
        "recent_window_weeks": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recent Window Weeks"
        },
        "anchor_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Date"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        }
      },
      "title": "DefaultTimeWindow",
      "type": "object"
    },
    "EvidenceNeed": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unavailable",
          "enum": [
            "resolved",
            "clarification_required",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "answer_type": {
          "anyOf": [
            {
              "enum": [
                "descriptive",
                "evaluative",
                "causal",
                "advisory",
                "general",
                "out_of_scope"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Type"
        },
        "literature_needed_for_answer": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literature Needed For Answer"
        },
        "explicit_literature_request": {
          "anyOf": [
            {
              "enum": [
                "none",
                "optional",
                "required"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explicit Literature Request"
        },
        "required_sources": {
          "items": {
            "enum": [
              "training_records",
              "literature"
            ],
            "type": "string"
          },
          "title": "Required Sources",
          "type": "array"
        },
        "optional_sources": {
          "items": {
            "const": "literature",
            "enum": [
              "literature"
            ],
            "type": "string"
          },
          "title": "Optional Sources",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "type": "string"
          },
          "title": "Source Spans",
          "type": "array"
        },
        "unresolved_fields": {
          "items": {
            "enum": [
              "question",
              "evidence_need"
            ],
            "type": "string"
          },
          "title": "Unresolved Fields",
          "type": "array"
        }
      },
      "title": "EvidenceNeed",
      "type": "object"
    },
    "ScopeObservation": {
      "additionalProperties": false,
      "properties": {
        "out_of_scope": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Out Of Scope"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "unsupported_domain",
                "unsupported_medical_request",
                "unsupported_personalized_prescription",
                "unsupported_data_or_operation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        }
      },
      "title": "ScopeObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "phase_a_semantics_v1",
      "default": "phase_a_semantics_v1",
      "enum": [
        "phase_a_semantics_v1"
      ],
      "title": "Version",
      "type": "string"
    },
    "parsing_source": {
      "anyOf": [
        {
          "enum": [
            "rule",
            "llm"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parsing Source"
    },
    "evidence_need": {
      "$ref": "#/$defs/EvidenceNeed"
    },
    "argument_resolution": {
      "$ref": "#/$defs/ArgumentResolution"
    },
    "default_time_window": {
      "$ref": "#/$defs/DefaultTimeWindow"
    },
    "scope": {
      "$ref": "#/$defs/ScopeObservation"
    }
  },
  "title": "PhaseASemantics",
  "type": "object"
}
