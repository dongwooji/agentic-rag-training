{
  "$defs": {
    "AnalysisOperation": {
      "enum": [
        "estimated_1rm",
        "first_last_n_session_median_e1rm",
        "weekly_volume",
        "weekly_frequency",
        "training_gap",
        "plateau_candidates"
      ],
      "title": "AnalysisOperation",
      "type": "string"
    },
    "GoldCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "expected_answer_type": {
          "anyOf": [
            {
              "enum": [
                "descriptive",
                "evaluative",
                "causal",
                "advisory",
                "general",
                "out_of_scope"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Answer Type"
        },
        "required_evidence_sources": {
          "items": {
            "enum": [
              "training_records",
              "literature"
            ],
            "type": "string"
          },
          "title": "Required Evidence Sources",
          "type": "array"
        },
        "optional_evidence_sources": {
          "items": {
            "const": "literature",
            "enum": [
              "literature"
            ],
            "type": "string"
          },
          "title": "Optional Evidence Sources",
          "type": "array"
        },
        "acceptable_record_operations": {
          "items": {
            "anyOf": [
              {
                "enum": [
                  "exercise_records",
                  "exercise_first_last",
                  "get_session",
                  "list_sessions"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1,
          "title": "Acceptable Record Operations",
          "type": "array"
        },
        "acceptable_metric_operation_sets": {
          "items": {
            "items": {
              "$ref": "#/$defs/AnalysisOperation"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Acceptable Metric Operation Sets",
          "type": "array"
        },
        "clarification_required": {
          "title": "Clarification Required",
          "type": "boolean"
        },
        "allowed_clarification_fields": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Clarification Fields",
          "type": "array"
        },
        "expected_final_behavior": {
          "enum": [
            "answer",
            "clarification",
            "abstain"
          ],
          "title": "Expected Final Behavior",
          "type": "string"
        },
        "expected_default_recent_window": {
          "title": "Expected Default Recent Window",
          "type": "boolean"
        },
        "literature_answerability": {
          "enum": [
            "answerable",
            "unanswerable",
            "not_applicable"
          ],
          "title": "Literature Answerability",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "pair_id",
        "expected_answer_type",
        "required_evidence_sources",
        "optional_evidence_sources",
        "acceptable_record_operations",
        "acceptable_metric_operation_sets",
        "clarification_required",
        "allowed_clarification_fields",
        "expected_final_behavior",
        "expected_default_recent_window",
        "literature_answerability"
      ],
      "title": "GoldCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "phase_a_evidence_gold_v2",
      "enum": [
        "phase_a_evidence_gold_v2"
      ],
      "title": "Version",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/GoldCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "version",
    "cases"
  ],
  "title": "GoldFile",
  "type": "object"
}
