{
  "version": "phase_a_acceptance_v2_protocol_v1",
  "gold_schema_version": "phase_a_evidence_gold_v2",
  "variants": {
    "A": "legacy",
    "B": "fixed_requirements_v1_1"
  },
  "same_code_sha": true,
  "interpretation_mode": "phase_a",
  "corpus_version": "literature_corpus_v1",
  "retrieval_config": "config/retrieval_step3b_translation_v1.json",
  "request": {
    "endpoint": "/query",
    "debug": true,
    "attempts_per_case_per_variant": 1,
    "automatic_retries": 0,
    "single_turn": true,
    "clarification_resume": false
  },
  "order": [
    "verify_manifest_and_questions",
    "execute_A",
    "execute_B",
    "freeze_all_raw",
    "verify_raw",
    "read_and_verify_gold",
    "score_offline"
  ],
  "old_metrics": "unchanged src.evaluation.phase_a_semantics.score",
  "additional_metrics": {
    "answerable_abstain": "count(literature_answerability == answerable AND behavior == abstain)",
    "unanswerable_answer": "count(literature_answerability == unanswerable AND behavior == answer)"
  },
  "adoption_all": [
    "B.answerable_abstain < A.answerable_abstain",
    "B.unanswerable_answer <= A.unanswerable_answer",
    "B.execution_failure <= A.execution_failure",
    "B.final_behavior_accuracy >= A.final_behavior_accuracy"
  ],
  "execution_failure_includes_http_and_transport": true,
  "automatic_default_change": false,
  "existing_dev_heldout_rerun": false,
  "prepared_with_synthetic_only": true,
